# Copy to .env and fill in. Never commit .env.
# The pipeline runs on this machine. The only credential is the Kaggle token
# used by `make download`.

# Kaggle API token: https://www.kaggle.com/settings (Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Spark driver memory for a full month on a laptop. The sample path uses 1g.
SPARK_DRIVER_MEMORY=8g
