# Copy to .env and fill in. Never commit .env.

# Kaggle API token: https://www.kaggle.com/settings (Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Standard AWS credential chain. Use a profile, or access keys, not both required.
AWS_PROFILE=clickstream
AWS_REGION=us-east-1
# Optional. Leave unset to use AWS_PROFILE or the instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Filled after Terraform apply, or chosen before python infra/bootstrap_cli.py.
S3_BUCKET=
GLUE_DATABASE=rees46
ATHENA_WORKGROUP=clickstream-to-cohorts
ATHENA_SCHEMA=analytics
# Example: s3://your-bucket/athena-results/
ATHENA_S3_STAGING_DIR=
# Example: s3://your-bucket/dbt/
ATHENA_S3_DATA_DIR=

# local exports the DuckDB dev marts. athena runs UNLOAD to S3.
EXPORT_TARGET=local

# Airflow dbt target. Use athena for the real replay. dev uses the DuckDB fixture.
DBT_TARGET=athena

# Optional monthly budget alert for infra/bootstrap.sh and Terraform.
BUDGET_ALERT_EMAIL=

# Spark driver memory for a full month on a laptop.
SPARK_DRIVER_MEMORY=8g
